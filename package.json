{
  "name": "bookforge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio --browser none",
    "db:check": "node --conditions=react-server --import tsx scripts/check-db.ts",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "puppeteer-core": "^23.11.1",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-link": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "dotenv": "18.0.7",
    "next": "^15.5.0",
    "pg": "8.23.1",
    "prosemirror-markdown": "1.13.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "0.0.1"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@aws-sdk/s3-request-presigner": "3.1156.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.0",
    "prisma": "7.10.0",
    "tailwindcss": "^4.1.0",
    "tsx": "4.23.15",
    "typescript": "^5.8.0"
  }
}
