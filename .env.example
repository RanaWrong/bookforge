# Safe local defaults only. Never place production secrets in this file.
NEXT_PUBLIC_APP_NAME=BookForge
NEXT_PUBLIC_DEFAULT_LOCALE=bn
NODE_ENV=development
BOOKFORGE_DEV_IDENTITY=false
# Set true only for local npm run dev. All visitors share one identity.
# This adapter is always disabled when NODE_ENV is not development.

# Copy to .env. Replace placeholders; do not use these values in production.
POSTGRES_USER=bookforge
POSTGRES_PASSWORD=replace_with_a_random_hex_password
POSTGRES_DB=bookforge
# Host tools use localhost via docker-compose.dev.yml. URL-encode credentials.
DATABASE_URL=postgresql://bookforge:replace_with_a_random_hex_password@127.0.0.1:5432/bookforge?schema=public
# Compose/Coolify app and migration containers MUST use the service hostname db.
DOCKER_DATABASE_URL=postgresql://bookforge:replace_with_a_random_hex_password@db:5432/bookforge?schema=public
