# Safe local defaults only. Never place production secrets in this file.
NEXT_PUBLIC_APP_NAME=BookForge
NEXT_PUBLIC_DEFAULT_LOCALE=bn
NODE_ENV=development
BOOKFORGE_DEV_IDENTITY=false
# Set true only for local npm run dev. All visitors share one identity.
# This adapter is always disabled when NODE_ENV is not development.

# Copy to .env. Replace placeholders; do not use these values in production.
POSTGRES_USER=bookforge
POSTGRES_PASSWORD=replace_with_a_random_hex_password
POSTGRES_DB=bookforge
# Host tools use localhost via docker-compose.dev.yml. URL-encode credentials.
DATABASE_URL=postgresql://bookforge:replace_with_a_random_hex_password@127.0.0.1:5432/bookforge?schema=public
# Compose/Coolify app and migration containers MUST use the service hostname db.
DOCKER_DATABASE_URL=postgresql://bookforge:replace_with_a_random_hex_password@db:5432/bookforge?schema=public

# Auth — required in production; generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=dev-only-ephemeral-session-secret-do-not-use-in-prod-32bytes
# Media storage — local filesystem volume (Coolify default) or S3-compatible
MEDIA_DIR=/tmp/bookforge-media
STORAGE_DRIVER=local
# If STORAGE_DRIVER=s3, also set: S3_ENDPOINT, S3_BUCKET, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY, S3_REGION
CHROMIUM_PATH=/usr/bin/chromium-browser

# Export file storage (src/lib/storage.ts)
# STORAGE_PROVIDER=local  — write export files to local disk (default)
# STORAGE_PROVIDER=s3     — upload to S3-compatible object storage
STORAGE_PROVIDER=local
# Local export directory used when STORAGE_PROVIDER=local
EXPORT_DIR=./output/exports
# AWS / S3-compatible settings — required when STORAGE_PROVIDER=s3
# AWS_S3_BUCKET=bookforge-exports
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=replace_with_access_key_id
# AWS_SECRET_ACCESS_KEY=replace_with_secret_access_key
